// Function to display registered users

function displayUsers(users) {

    let rows = "";

    users.forEach(function(user) {

        rows += `
        <tr>
            <td>${escapeHTML(user.name)}</td>
            <td>${escapeHTML(user.email)}</td>
            <td>${escapeHTML(user.age)}</td>
            <td>${escapeHTML(user.mobile)}</td>
            <td>${escapeHTML(user.gender)}</td>
            <td>${escapeHTML(user.state)}</td>
        </tr>
        `;

    });

    return `
    <!DOCTYPE html>
    <html>
    <head>
        <title>Registration Details</title>

        <style>
            body {
                font-family: Arial;
                background-color: lightblue;
                margin: 30px;
            }

            h1 {
                text-align: center;
                color: darkblue;
            }

            table {
                width: 100%;
                background-color: white;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid black;
                padding: 12px;
                text-align: center;
            }

            th {
                background-color: darkblue;
                color: white;
            }

            button {
                background-color: darkblue;
                color: white;
                padding: 10px;
                border: none;
                cursor: pointer;
                margin: 15px;
            }
        </style>
    </head>

    <body>

        <h1>Registered User Details</h1>

        <table>

            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Mobile</th>
                <th>Gender</th>
                <th>State</th>
            </tr>

            ${rows}

        </table>

        <center>
            <a href="/">
                <button>Back to Registration</button>
            </a>
        </center>

    </body>
    </html>
    `;
}


// Escape HTML characters before displaying database values

function escapeHTML(value) {

    return String(value).replace(/[&<>"']/g, function(char) {

        const entities = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        };

        return entities[char];

    });

}


// Create Node.js Server

async function startServer() {

    await client.connect();

    console.log("MongoDB Connected Successfully");


    const db = client.db("registrationDB");

    const collection = db.collection("users");


    const server = http.createServer(async function(req, res) {


        // Display Home Page

        if (req.url === "/" && req.method === "GET") {

            res.writeHead(200, {
                "Content-Type": "text/html"
            });

            res.end(homePage());

        }


        // Process Registration Form

        else if (req.url === "/server" && req.method === "POST") {

            let rawData = "";

            req.on("data", function(data) {

                rawData += data;

            });

            req.on("end", async function() {

                try {

                    const formData = new URLSearchParams(rawData);

                    const user = {

                        name: formData.get("name"),

                        email: formData.get("email"),

                        age: Number(formData.get("age")),

                        mobile: formData.get("mobile"),

                        gender: formData.get("gender"),

                        state: formData.get("state")

                    };


                    // Insert user details into MongoDB

                    await collection.insertOne(user);

                    console.log("User details inserted successfully");


                    // Retrieve user details from MongoDB

                    const users = await collection.find().toArray();


                    // Display details in table format

                    res.writeHead(200, {
                        "Content-Type": "text/html"
                    });

                    res.end(displayUsers(users));

                }

                catch(error) {

                    console.log(error);

                    res.writeHead(500, {
                        "Content-Type": "text/plain"
                    });

                    res.end("Error processing registration.");

                }

            });

        }


        else {

            res.writeHead(404, {
                "Content-Type": "text/plain"
            });

            res.end("Page Not Found");

        }

    });


    // Start server on port 6000

    server.listen(6000, function() {

        console.log("Server running at http://localhost:6000");

    });

}


// Start application

startServer().catch(function(error) {

    console.log("Server Error:", error);

});

